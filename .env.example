APP_ENV=production
APP_NAME=Sukoon Health API
FRONTEND_ORIGIN=https://sukoonhealth.shop

DATABASE_URL=postgresql+asyncpg://sukoonhealth:<password>@sukoonhealth_sukoonhealth:5432/sukoonhealth

GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx6GfqsXqtZmv5GngHHQKEiOPcnYYUf5eTq0k4ZlCxUdoKt2fypcDp5qEGS3AFE8SGV/exec

META_PIXEL_ID=
META_ACCESS_TOKEN=
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
SNAP_PIXEL_ID=89f351c0-6897-4028-9f29-9808fbe991ed
SNAP_ACCESS_TOKEN=

HASH_SALT=

# Backend-only MaxMind minFraud IP screening.
# Blocks clear non-KSA / high-risk IPs when ENABLE_IP_FRAUD_CHECK=true.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
ENABLE_IP_FRAUD_CHECK=false
MAXMIND_RISK_SCORE_THRESHOLD=25
MAXMIND_ALLOWED_COUNTRY=SA
WHITELISTED_PHONES=

# Admin dashboard (backend /api/admin/*)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Ad redirect admin (/redirectnadia — separate from main admin)
REDIRECT_ADMIN_PASSWORD=choose-a-strong-password
REDIRECT_SESSION_SECRET=change-this-to-another-long-random-secret

# Checkout
COD_FEE_SAR=0
SITE_URL=https://sukoonhealth.shop
API_PUBLIC_URL=https://api.sukoonhealth.shop

# Public WhatsApp click-to-chat (Saudi number, digits only, e.g. 9665XXXXXXXX)
WHATSAPP_BUSINESS_NUMBER=966550412188
WHATSAPP_PREFILL_MESSAGE=السلام عليكم، أحتاج مساعدة بخصوص طلب من سُكون للصحة

# WhatsApp Cloud API (Meta) — needed for admin inbox receive + reply
# Webhook URL: https://api.sukoonhealth.shop/api/whatsapp/webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=sukoon-wa-verify
WHATSAPP_API_VERSION=v21.0

LIVE_VISITOR_TTL_SECONDS=60
RECORDING_MAX_EVENTS=8000
RECORDING_MAX_CHUNKS=40
